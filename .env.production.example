# PRODUCTION ENVIRONMENT - DO NOT RUN migrate:fresh, migrate:reset, or tinker
# These commands WILL DELETE ALL DATA

APP_ENV=production
APP_DEBUG=false

# ⚠️ SAFETY: Never use these in production:
# - php artisan migrate:fresh (DELETES EVERYTHING)
# - php artisan migrate:reset (DELETES EVERYTHING)  
# - php artisan tinker (DANGEROUS REPL)
#
# ONLY use:
# - php artisan migrate (new migrations only)
# - php artisan backup (create backups)

# Always test database changes on STAGING first
# Keep daily automated backups
# Monitor /storage/backups/ regularly
